<?xml version="1.0"?>
<sdf version="1.6">
  <model name="moving_obstacle">
    <static>false</static>

    <link name="obstacle_link">
      <pose>0 0 0.3 0 0 0</pose>

      
<inertial>
  <mass>1.0</mass>
  <inertia>
    <ixx>0.060625</ixx>
    <iyy>0.060625</iyy>
    <izz>0.06125</izz>
    <ixy>0</ixy>
    <ixz>0</ixz>
    <iyz>0</iyz>
  </inertia>
</inertial>

<collision name="collision">
  <geometry>
    <cylinder>
      <radius>0.35</radius>
      <length>0.6</length>
    </cylinder>
  </geometry>
</collision>


      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
    </link>

    <plugin name="obstacle_controller"
            filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/moving_obstacle</namespace>
      </ros>
      <odometry_frame>world</odometry_frame>
      <robot_base_frame>obstacle_link</robot_base_frame>
      <odometry_topic>odom</odometry_topic>
      <command_topic>cmd_vel</command_topic>
      <odometry_rate>20</odometry_rate>
    </plugin>
  </model>
</sdf>
